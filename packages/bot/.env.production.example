# Production Environment Variables

# ===========================
# AWS KMS Configuration
# ===========================
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-key-id

# ===========================
# Encrypted Private Keys (Base64 KMS Ciphertext)
# ===========================
# Generate with: aws kms encrypt --key-id $AWS_KMS_KEY_ID --plaintext "0xYourPrivateKey" --query CiphertextBlob --output text
AWS_KMS_ENCRYPTED_KEY_ETH=AQICAHi...base64...
AWS_KMS_ENCRYPTED_KEY_ARB=AQICAHi...base64...
AWS_KMS_ENCRYPTED_KEY_BASE=AQICAHi...base64...
AWS_KMS_ENCRYPTED_KEY_OP=AQICAHi...base64...
AWS_KMS_ENCRYPTED_KEY_MATIC=AQICAHi...base64...

# ===========================
# RPC Endpoints (Alchemy, Infura, or self-hosted)
# ===========================
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR-API-KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR-API-KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR-API-KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# ===========================
# Vault Configuration (Alternative to KMS)
# ===========================
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=s.your-vault-token
# VAULT_NAMESPACE=trading-bot

# ===========================
# Application Configuration
# ===========================
NODE_ENV=production
CONFIG_PATH=./config/prod.yaml
LOG_LEVEL=info

# ===========================
# Monitoring & Alerts
# ===========================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===========================
# Optional: CloudWatch Logging
# ===========================
# AWS_CLOUDWATCH_LOG_GROUP=/trading-bot/production
# AWS_CLOUDWATCH_LOG_STREAM=instance-1
