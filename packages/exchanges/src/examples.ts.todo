import { createPublicClient, createWalletClient, http } from 'viem';
import { mainnet, base } from 'viem/chains';
import { privateKeyToAccount } from 'viem/accounts';
import {
  createUniswapV2Adapter,
  createUniswapV3Adapter,
  createSushiSwapAdapter,
  createZeroExAdapter,
  createOneInchAdapter,
  createCowSwapAdapter,
  createAcrossAdapter,
  wrapWithMEVProtection,
  Token,
  TokenAmount,
} from './index';

/**
 * Example usage of the exchange adapters
 */
async function exampleUsage() {
  // Setup clients
  const publicClient = createPublicClient({
    chain: mainnet,
    transport: http('https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY'),
  });

  const account = privateKeyToAccount('0x...');
  const walletClient = createWalletClient({
    account,
    chain: mainnet,
    transport: http('https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY'),
  });

  // Define tokens
  const WETH: Token = {
    address: '0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2',
    symbol: 'WETH',
    decimals: 18,
    chainId: 1,
    name: 'Wrapped Ether',
  };

  const USDC: Token = {
    address: '0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48',
    symbol: 'USDC',
    decimals: 6,
    chainId: 1,
    name: 'USD Coin',
  };

  const inputAmount: TokenAmount = {
    token: WETH,
    amount: BigInt(1e18), // 1 WETH
  };

  // Example 1: Uniswap V2
  const uniswapV2 = createUniswapV2Adapter(publicClient, walletClient, 1);
  const v2Quote = await uniswapV2.getQuote(inputAmount, USDC, 0.5);
  console.log('Uniswap V2 Quote:', v2Quote);

  // Example 2: Uniswap V3
  const uniswapV3 = createUniswapV3Adapter(publicClient, walletClient, 1);
  const v3Quote = await uniswapV3.getQuote(inputAmount, USDC, 0.5);
  console.log('Uniswap V3 Quote:', v3Quote);

  // Example 3: 0x Protocol (aggregator)
  const zeroEx = createZeroExAdapter(publicClient, walletClient, 'YOUR-0X-API-KEY');
  const zeroExQuote = await zeroEx.getQuote(inputAmount, USDC, 0.5);
  console.log('0x Quote:', zeroExQuote);

  // Example 4: 1inch (aggregator)
  const oneInch = createOneInchAdapter(publicClient, walletClient, 'YOUR-1INCH-API-KEY');
  const oneInchQuote = await oneInch.getQuote(inputAmount, USDC, 0.5);
  console.log('1inch Quote:', oneInchQuote);

  // Example 5: CoW Swap (MEV-protected)
  const cowSwap = createCowSwapAdapter(publicClient, walletClient);
  const cowQuote = await cowSwap.getQuote(inputAmount, USDC, 0.5);
  console.log('CoW Swap Quote:', cowQuote);

  // Example 6: MEV Protection Wrapper
  const protectedUniswap = wrapWithMEVProtection(
    uniswapV3,
    publicClient,
    walletClient
  );
  const protectedQuote = await protectedUniswap.getQuote(inputAmount, USDC, 0.5);

  // Execute with MEV protection
  await protectedUniswap.executeSwap(protectedQuote, {
    flashbots: true,
    waitForConfirmation: true,
  });

  // Example 7: Cross-chain swap with Across
  const across = createAcrossAdapter(publicClient, walletClient, 1);
  const crossChainQuote = await across.getCrossChainQuote(inputAmount, USDC, {
    destinationChainId: 10, // Optimism
    slippage: 0.5,
    bridge: 'across',
  });
  console.log('Cross-chain Quote:', crossChainQuote);

  // Example 8: Check and approve if needed
  const needsApproval = await uniswapV3.needsApproval(
    WETH,
    inputAmount.amount,
    account.address
  );

  if (needsApproval) {
    const approvalTx = await uniswapV3.getApprovalTransaction(
      WETH,
      inputAmount.amount
    );
    if (approvalTx) {
      const hash = await walletClient.sendTransaction(approvalTx as any);
      console.log('Approval transaction:', hash);
    }
  }

  // Example 9: Build and execute standard swap
  const quote = await uniswapV3.getQuote(inputAmount, USDC, 0.5);
  const tx = await uniswapV3.buildTransaction(quote, {
    slippage: 0.5,
    deadline: Math.floor(Date.now() / 1000) + 1200,
  });

  const result = await uniswapV3.executeSwap(quote, {
    flashbots: false,
    waitForConfirmation: true,
  });

  console.log('Swap result:', result);
}

/**
 * Example: Compare quotes from multiple sources
 */
async function compareBestQuote(
  publicClient: any,
  walletClient: any,
  input: TokenAmount,
  output: Token
) {
  const adapters = [
    createUniswapV2Adapter(publicClient, walletClient, 1),
    createUniswapV3Adapter(publicClient, walletClient, 1),
    createSushiSwapAdapter(publicClient, walletClient, 1),
  ];

  const quotes = await Promise.allSettled(
    adapters.map((adapter) => adapter.getQuote(input, output, 0.5))
  );

  const validQuotes = quotes
    .filter((result) => result.status === 'fulfilled')
    .map((result: any) => result.value);

  // Find best quote (highest output amount)
  const bestQuote = validQuotes.reduce((best, current) =>
    current.outputAmount.amount > best.outputAmount.amount ? current : best
  );

  console.log('Best quote from:', bestQuote.exchangeId);
  console.log('Output amount:', bestQuote.outputAmount.amount);

  return bestQuote;
}

export { exampleUsage, compareBestQuote };
